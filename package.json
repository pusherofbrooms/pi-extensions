{
  "name": "pi-extensions",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node --import tsx --test tests/*.test.mjs tests/*.test.ts",
    "test:integration": "node --import tsx --test tests/*.integration.mjs",
    "test:secrets": "node --import tsx --test tests/secret-detection.test.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run test:secrets"
  },
  "dependencies": {
    "defuddle": "^0.19.3",
    "linkedom": "^0.18.13"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.99.1",
    "@earendil-works/pi-coding-agent": "0.99.1",
    "typebox": "^1.3.19",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./show-system-prompt.ts",
      "./web-tools.ts",
      "./subagents.ts",
      "./openai-codex-image-gen.ts",
      "./goal.ts"
    ]
  }
}
